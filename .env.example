# Local MAF comparison service (Vite dev proxy only).
DECISION_WORKFLOW_URL=http://127.0.0.1:8008
WORKFLOW_ALLOWED_ORIGINS=http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176

# Exact synthetic snapshot retrieval; separate from the live IQ agent path.
# Uses DefaultAzureCredential with https://search.azure.com/.default.
DECISION_RECORDS_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
DECISION_RECORDS_SEARCH_INDEX=decision-demo-snapshots-v1

# Optional existing hosted deployments. Leave empty for rules-only decisions.
# Live evidence still invokes all three hosted IQ agents and incurs retrieval costs.
# Resource origins only; do not use a project, Responses, or systemone URL.
# Examples: https://<resource>.openai.azure.com and https://<resource>.services.ai.azure.com
LLM_ENDPOINT=
LLM_DEPLOYMENT=
DECISION1_ENDPOINT=
DECISION1_DEPLOYMENT=

# USD retail estimates per million tokens; recheck for your deployment and agreement.
# GPT-4o 2024-11-20 Global Standard; Decision-1 input only (output free).
# Source: https://prices.azure.com/api/retail/prices (eastus2 Consumption meters).
LLM_INPUT_USD_PER_MILLION=2.50
LLM_CACHED_INPUT_USD_PER_MILLION=1.25
LLM_OUTPUT_USD_PER_MILLION=10.00
DECISION1_INPUT_USD_PER_MILLION=0.042

# Deployed Foundry IQ docs agent endpoint (Responses protocol).
# Server-side only (no VITE_ prefix), used by the MAF backend and legacy Vite proxy.
# Configure all three IQ URLs for live workflow runs. Requires a permitted local
# DefaultAzureCredential identity for https://ai.azure.com/.default.
FOUNDRY_IQ_AGENT_URL=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>/agents/decision-foundryiq-docs-agent/endpoint/protocols/openai/responses?api-version=v1

# Fabric IQ sales agent endpoint (Responses protocol). Same auth as above.
# The existing hosted agent calls the published Fabric Data agent's MCP endpoint
# using its configured service principal. This is not browser-user OBO auth.
# Fabric capacity must be active; source dates remain unknown if not retrieved.
FABRIC_IQ_AGENT_URL=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>/agents/fabriciq-sales-agent/endpoint/protocols/openai/responses?api-version=v1

# Deployed Web IQ climate agent endpoint (Responses protocol). Same auth as above.
WEBIQ_AGENT_URL=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>/agents/webiq-climate-agent/endpoint/protocols/openai/responses?api-version=v1

# Synergy agent endpoint (Responses protocol). Same auth as above. A 4th
# Foundry Hosted Agent (agent/synergy_agent.py) with no tools — it only
# synthesizes the other three agents' already-grounded answers (given to it
# inline in the prompt) into one takeaway. Used by the cross-IQ fan-out flow.
SYNERGY_AGENT_URL=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>/agents/synergy-agent/endpoint/protocols/openai/responses?api-version=v1

# Optional MSAL sign-in for the inherited browser console, not MAF authorization.
# MAF live calls use local developer credentials, regardless of UI persona.
# MSAL config for the browser (src/auth.js). VITE_ prefix means these
# are bundled into client-side JS — that's fine, a SPA app registration's
# client ID is a public identifier (PKCE, no client secret involved), not a
# secret. Requires an Entra ID App Registration (SPA platform, redirect URI
# matching this dev server's origin) with a delegated user_impersonation
# permission on the "Azure Machine Learning Services" first-party resource
# app (App ID 18a66f5f-dbdf-4c17-9dd7-1634712a9cbe) — the resource backing
# the https://ai.azure.com/.default scope — with admin consent granted.
VITE_MSAL_CLIENT_ID=<your-spa-app-registration-client-id>
VITE_MSAL_TENANT_ID=<your-tenant-id>
