# Deployed Foundry IQ docs agent endpoint (Responses protocol).
# Server-side only (no VITE_ prefix) — read by vite.config.js's dev-server
# proxy, never bundled into client-side JS. Requires `az login` locally so
# DefaultAzureCredential can mint a token for https://ai.azure.com/.default.
FOUNDRY_IQ_AGENT_URL=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>/agents/foundryiq-docs-agent/endpoint/protocols/openai/responses?api-version=v1

# Fabric IQ sales agent endpoint (Responses protocol). Same auth as above.
# This is the custom-hosted agent/fabric_agent.py container (fabriciq-sales-agent),
# grounded via the native Foundry Fabric data agent tool (a published Fabric Data
# agent over the live semantic model, wired in via FABRIC_PROJECT_CONNECTION_ID).
# The Fabric tool call itself only supports user-identity (OBO) auth, which is why
# real sign-in (src/auth.js) is required for Live: Fabric IQ — see docs/azure-implementation.md.
FABRIC_IQ_AGENT_URL=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>/agents/fabriciq-sales-agent/endpoint/protocols/openai/responses?api-version=v1

# Deployed Web IQ climate agent endpoint (Responses protocol). Same auth as above.
WEBIQ_AGENT_URL=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>/agents/webiq-climate-agent/endpoint/protocols/openai/responses?api-version=v1

# Synergy agent endpoint (Responses protocol). Same auth as above. A 4th
# Foundry Hosted Agent (agent/synergy_agent.py) with no tools — it only
# synthesizes the other three agents' already-grounded answers (given to it
# inline in the prompt) into one takeaway. Used by the cross-IQ fan-out flow.
SYNERGY_AGENT_URL=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>/agents/synergy-agent/endpoint/protocols/openai/responses?api-version=v1

# MSAL sign-in config for the browser (src/auth.js). VITE_ prefix means these
# are bundled into client-side JS — that's fine, a SPA app registration's
# client ID is a public identifier (PKCE, no client secret involved), not a
# secret. Requires an Entra ID App Registration (SPA platform, redirect URI
# matching this dev server's origin) with a delegated user_impersonation
# permission on the "Azure Machine Learning Services" first-party resource
# app (App ID 18a66f5f-dbdf-4c17-9dd7-1634712a9cbe) — the resource backing
# the https://ai.azure.com/.default scope — with admin consent granted.
VITE_MSAL_CLIENT_ID=<your-spa-app-registration-client-id>
VITE_MSAL_TENANT_ID=<your-tenant-id>
