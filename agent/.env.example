# Foundry project connection (this project's own Foundry project — separate from lead-agent-demo's)
# Copy this file to .env and fill in real values. .env is gitignored.

FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o

# Azure AI Search — Foundry IQ grounding source for the Product Docs domain
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_INDEX_NAME=product-docs
AZURE_SEARCH_SEMANTIC_CONFIG_NAME=product-docs-semantic-config

# Fabric IQ grounding source for the Sales Performance domain — a published
# Fabric Data agent, queried directly via its MCP endpoint (Foundry's native
# fabric_dataagent_preview tool returns "No CustomKeys connection found" for
# every connection tried — a server-side bug, see fabric_agent.py). Auth is a
# service-principal credential (create via `az ad sp create-for-rbac`), granted
# Member access on the Fabric workspace (POST
# https://api.fabric.microsoft.com/v1/workspaces/<workspace-id>/roleAssignments
# with {"principal":{"id":"<sp-object-id>","type":"ServicePrincipal"},"role":"Member"}).
# Viewer role is not enough — the underlying semantic model needs Member+ to
# read through a service principal.
FABRIC_TENANT_ID=<your-tenant-id>
FABRIC_CLIENT_ID=<your-service-principal-app-id>
FABRIC_CLIENT_SECRET=<your-service-principal-secret>
FABRIC_WORKSPACE_ID=<your-fabric-workspace-id>
FABRIC_DATA_AGENT_ID=<your-fabric-data-agent-item-id>

# Microsoft Web IQ (webiq.microsoft.ai) — Web IQ grounding source for the Climate/Disaster Risk domain
# Auth is a plain API key header (x-apikey) — no Azure AD/RBAC needed for this one.
WEBIQ_API_KEY=<your-webiq-api-key>

